{
  "name": "@jack.winter/pancake-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Reusable React components, compiled styles, and design tokens for web apps.",
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "docs/styling.md",
    "docs/verification.md",
    "docs/installation.md",
    "docs/components.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "tokens": "node scripts/generate-theme.mjs",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "example": "npm run build && npm --prefix examples/web install && npm --prefix examples/web run dev",
    "test:package": "npm run prepare:tests && playwright test",
    "verify": "npm run check:source && npm run test:verification && npm run verify:build && npm run test:package",
    "prepack": "npm run build",
    "release:local": "node scripts/release-local.mjs",
    "check:styles": "node scripts/generate-theme.mjs --check && node scripts/check-styles.mjs",
    "test:styles": "node --test scripts/style-*.test.mjs",
    "check:comparison": "node scripts/check-comparison.mjs",
    "test:comparison": "node --test scripts/check-comparison.test.mjs",
    "test:visual": "npm run check:comparison && playwright test -c playwright.visual.config.ts",
    "test:visual:update": "npm run check:comparison && npm run storybook:build && playwright test -c playwright.visual.config.ts --update-snapshots",
    "check:contracts": "node scripts/check-contracts.mjs",
    "test:contracts": "node --test scripts/check-contracts.test.mjs",
    "test:verification": "node --test scripts/verification.test.mjs",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "test:structure": "node --test scripts/check-structure.test.mjs",
    "check:stories": "node scripts/check-stories.mjs",
    "test:stories": "node --test scripts/check-stories.test.mjs",
    "check:stories:built": "node scripts/check-stories.mjs --built",
    "check:source": "npm run format:check && npm run typecheck && npm run lint && npm run check:structure && npm run test:structure && npm run check:styles && npm run test:styles && npm run check:comparison && npm run test:comparison && npm run check:stories && npm run test:stories && npm run check:contracts && npm run test:contracts && npm run test:ci && npm run test:publish && npm run test:archive",
    "verify:build": "npm run build && npm run storybook:build && npm run check:stories:built",
    "prepare:tests": "node scripts/prepare-consumer.mjs && npm run check:compatibility",
    "test:ci": "node --test scripts/ci.test.mjs",
    "test:publish": "node --test scripts/publish.test.mjs",
    "test:archive": "node --test scripts/validate-archive.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j4ckwinter/pancake-ui.git"
  },
  "homepage": "https://github.com/j4ckwinter/pancake-ui#readme",
  "bugs": {
    "url": "https://github.com/j4ckwinter/pancake-ui/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
